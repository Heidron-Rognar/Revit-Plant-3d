<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PlantDraw</RootNamespace>
    <AssemblyName>PlantDraw</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>portable</DebugType>
    <!-- Deterministic output folder so the installer can always find the DLL. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      Revit install folder that holds RevitAPI.dll / RevitAPIUI.dll.
      Override on the command line if your Revit lives somewhere else:
        dotnet build -c Release -p:RevitApiDir="D:\Apps\Revit 2026\"
      Revit 2025 and Revit 2026 both run on .NET 8, so this project targets them.
      For Revit 2024 and older you must switch TargetFramework to net48.
    -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)\</RevitApiDir>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <Company>Plant Draw</Company>
    <Product>Plant Draw for Revit</Product>
    <Description>Plant 3D style 3D direction pad / ortho routing for Autodesk Revit.</Description>
    <Copyright>Copyright (c) 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)RevitAPI.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <!-- Friendly error if the Revit API is not where we expect it. -->
  <Target Name="CheckRevitApi" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RevitApiDir)RevitAPI.dll')"
           Text="RevitAPI.dll was not found in '$(RevitApiDir)'. Install Revit $(RevitVersion) or build with -p:RevitApiDir=&quot;&lt;path to the Revit program folder&gt;\&quot;." />
  </Target>

</Project>
